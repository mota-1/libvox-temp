# /libvox-mcp configuration. Copy to .env and edit.
#
# This server holds no ILS credentials and no tenant data — those live in
# /libvox-core. Everything below is either where to find Core, or how to
# advertise this endpoint to MCP clients.

# --- Where the tools are actually implemented -------------------------------

# Base URL of /libvox-core. This value is for a host-side run: the container
# overrides it with http://core:8091, reached over the shared libvox_internal
# network, because Core's internal API is bound to the host's loopback and no
# container can reach that.

# Per-request timeout, in seconds, for calls to Core.
#
# Sixty, and it belongs to a ladder: each layer is more patient than the one it
# waits on. The Koha driver allows thirty seconds per request, this allows sixty
# for the call it makes to Core, and Core allows ninety on this server. One
# check_availability against a library on another continent is four sequential
# requests, so a layer that gave up first would discard an answer that had
# already arrived.
LIBVOX_CORE_TIMEOUT=60

# Shared secret identifying *this MCP instance* to Core. It authenticates the
# server, never a tenant — tenant comes from the caller's own credential on
# every request.
#
# **Byte-identical to /libvox-core's LIBVOX_CORE_SERVICE_TOKEN.** The names
# differ because the meanings do — one is demanded, the other presented — and
# the values must not:
#
#   grep '^LIBVOX_CORE_SERVICE_TOKEN=' ../libvox-core/.env
#
# A mismatch is not a startup failure. It is a 401 on every tool call, which a
# reader sees as the catalogue being unavailable and a log shows only as an
# unhelpful "could not reach the tool layer". Required by docker-compose.yml,
# which refuses to start without it; optional for a host-side run against a
# Core that has no token of its own.
LIBVOX_MCP_SERVICE_TOKEN=

# --- OAuth 2.1 resource server ----------------------------------------------

# Who mints session credentials (Core's auth endpoint).
LIBVOX_ISSUER_URL=http://127.0.0.1:8091

# Public URL of this MCP endpoint, as clients will reach it.
LIBVOX_RESOURCE_URL=http://127.0.0.1:8000/mcp

# Scopes a credential must carry to reach any tool. Space- or comma-separated.
LIBVOX_REQUIRED_SCOPES=catalog:read

# --- Transport --------------------------------------------------------------

# stdio (default) or streamable-http. Authorization rides HTTP headers, so it
# exists only on streamable-http — on stdio every caller is anonymous.
LIBVOX_MCP_TRANSPORT=stdio
LIBVOX_MCP_HOST=127.0.0.1
LIBVOX_MCP_PORT=8000

LIBVOX_LOG_LEVEL=INFO

# --- EXPERIMENT: direct Koha backend (temporary) -----------------------------
#
# Answers the tools from one Koha instead of from Core, so an agent can be
# watched using them before Core exists. Off by default.
#
# What it gives up, deliberately: there is no tenant, no OAuth and no
# authorization — the process serves one library to whoever connects — and
# every search becomes live load on that library's server, which is the exact
# thing the Discovery Index exists to prevent. Single-tenant, local, temporary.
#
# Needs the sibling driver installed:  pip install -e ../libvox-driver-koha
#
# LIBVOX_MCP_BACKEND=koha
# KOHA_URL=http://127.0.0.1:8081
# KOHA_CLIENT_ID=
# KOHA_CLIENT_SECRET=
