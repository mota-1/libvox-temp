APP_NAME=LibVox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The Tenant DB. A separate database from the Discovery Index, which is
# /libvox-sync's and lives on port 5433 -- see the README.
#
# Two roles, two jobs. libvox_app is unprivileged so that row-level security
# actually applies; a superuser here would make every policy decorative, and
# the application refuses to boot if it detects one.
LIBVOX_TENANT_DB_DSN=postgresql://libvox_app:libvox_app@127.0.0.1:5435/libvox_tenant

# Migrations only: creating extensions, tables, policies and functions needs
# the owner. `php artisan migrate --database=pgsql_admin`.
LIBVOX_TENANT_DB_ADMIN_DSN=postgresql://libvox:libvox@127.0.0.1:5435/libvox_tenant

# Encrypts stored ILS client secrets, through pgcrypto, with the key passed as
# a bind parameter on every statement. NEVER commit it, and never store it in
# the database it protects -- a key kept beside its ciphertext is decoration.
#
#   export LIBVOX_CRYPTO_KEY="$(openssl rand -base64 32)"
#
# Keep it: credentials stored under one key cannot be read back with another,
# and /libvox-sync must be given the same value to read what this portal wrote.
LIBVOX_CRYPTO_KEY=

# file, not database: the default connection has FORCE ROW LEVEL SECURITY, and
# a session row is written at the login screen -- before any tenant is bound.
# The policy would refuse the insert, and the symptom is a login form that
# redirects to itself forever with no error. Same reasoning for cache and queue.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Where /libvox-core publishes its public surface -- the widget script and the
# WebSocket behind it. Used to generate the embed a library pastes into its
# OPAC, and to load the widget for the preview on the Assistant page.
#
# This portal never serves the widget itself: it is the management plane, and
# putting it in the path of every OPAC page view would mean this application
# going down takes every library's widget with it.
# Where a reader's browser reaches /libvox-core. Leave it blank and the
# Assistant page derives it from the address you are reaching the panel at:
# same origin when that address has no port, Core's port when it has one. That
# is right whenever the two share a host.
#
# **Set it whenever deploy/host.env names a LIBVOX_WIDGET_DOMAIN**, which is
# the shipped proxied deployment -- the widget has a hostname of its own there
# and no guess from this panel's own address can find it. Nothing fails when
# this is wrong except the one line a library pastes into its OPAC, which is
# why `./deploy/up.sh` compares the two and says so.
#
#   LIBVOX_WIDGET_URL=https://marcia.exemplo.br
LIBVOX_WIDGET_URL=
LIBVOX_WIDGET_PORT=8092

# The offer of source LibVox shows the people working in its panels, in the
# footer of both of them.
#
# LibVox is AGPL-3.0, and §13 asks a *modified* version served over a network to
# give the people using it a way to obtain the corresponding source. Left as it
# is, this points at the project. **Change it if you modify LibVox**: your users
# are owed your source, and a link to ours sends them to code nobody is running.
#
# Empty removes the link, which is the deployment holding a commercial licence
# rather than the AGPL. The widget offers a reader nothing of the kind, so this
# variable lives here and nowhere else -- if you modify LibVox and serve it, the
# offer to your readers is yours to make.
LIBVOX_SOURCE_URL=https://github.com/anselmobattisti/libvox

# The Discovery Index -- the read model /libvox-sync builds from each library's
# ILS. This application only reads it, and the Catalogue screen is the only
# thing that opens it at all.
#
# Unprivileged, so row-level security applies: a superuser here would show
# every library's catalogue to every librarian, and the screen would look
# perfectly correct while doing it. CatalogRecord checks rather than trusts.
LIBVOX_DISCOVERY_DB_DSN=postgresql://libvox_app:libvox_app@127.0.0.1:5435/libvox_index

# The conversation log -- what patrons asked and what MARC.IA answered.
# /libvox-core writes it; this application only reads it, on the Conversations
# screen of the operator panel, one library at a time.
#
# Unprivileged, so row-level security applies. Nothing in those tables
# identifies a person, and retention is enforced by `libvox-core prune`.
LIBVOX_CONVERSATION_DB_DSN=postgresql://libvox_app:libvox_app@127.0.0.1:5435/libvox_conversations

# /libvox-core's internal API, used for one thing: the "test the connection"
# button on the catalogue page. This application cannot answer that itself --
# its credential store has no read path, by design and by test -- so it asks
# the component that may decrypt.
#
# The token authenticates this service, never a library. Copy it from
# /libvox-core's own .env; without it Core refuses the call outside development.
LIBVOX_CORE_URL=http://127.0.0.1:8091
LIBVOX_CORE_SERVICE_TOKEN=
