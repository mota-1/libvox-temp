# /libvox-driver-koha configuration. Copy to .env and edit.
#
# Standalone mode only. In production the connection block arrives in the
# invocation request, injected by /libvox-core at call time — the driver reads
# no credentials from its own environment there.

# The host-native URL. Used as-is when you run the CLI directly.
KOHA_URL=http://127.0.0.1:8081

# Only when the container needs a different address than the host does. Inside
# a container 127.0.0.1 is the container, so a Koha running on the host is
# reached by name; docker-compose.yml maps that name on Linux too. Leave it
# commented and both ways use KOHA_URL.
# KOHA_URL_DOCKER=http://host.docker.internal:8081

# Koha: Administration -> Manage API keys, on a patron that has the `catalogue`
# permission and a `userid`. Both are required — a patron holding the flag but
# no userid still fails every permission check, because Koha resolves
# permissions through the login name.
#
# `catalogue` alone is enough for LibVox and is all a library should grant:
# read access to bibliographic and item data, with no circulation, no editing
# and no patron data. LibVox never writes to an ILS.
KOHA_CLIENT_ID=
KOHA_CLIENT_SECRET=

LIBVOX_LOG_LEVEL=INFO
